+package repo
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/tinyrange/trex/storage"
+)
+
+func TestIndexedRefPromotionRecoveryAndScaling(t *testing.T) {
+	for _, count := range []int{100, 10000} {
+		t.Run(fmt.Sprint(count), func(t *testing.T) {
